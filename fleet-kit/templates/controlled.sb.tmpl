(version 1)
(allow default)
(deny network*)
(allow network-outbound (remote ip "localhost:@@CN_API_PORT@@") (remote ip "localhost:@@API_ADAPTER_PORT@@") (remote ip "localhost:@@WEB_PROXY_PORT@@") (remote ip "*:@@JP_API_PORT@@") (remote ip "*:@@JP_EGRESS_PORT@@"))
(allow network-bind (local ip "localhost:@@CN_API_PORT@@") (local ip "localhost:@@API_ADAPTER_PORT@@") (local ip "localhost:@@WEB_PROXY_PORT@@"))
(allow network-inbound (local ip "localhost:@@CN_API_PORT@@") (local ip "localhost:@@API_ADAPTER_PORT@@") (local ip "localhost:@@WEB_PROXY_PORT@@"))
(deny appleevent-send)
(deny process-exec (literal "/usr/bin/sudo") (literal "/usr/bin/osascript") (literal "/usr/bin/open") (literal "/bin/launchctl"))
(deny mach-lookup (global-name "com.apple.coreservices.launchservicesd") (global-name "com.apple.xpc.launchd") (global-name "com.apple.appleeventsd"))
(deny mach-task-name)
(deny file-write* (subpath "@@INSTALL_BASE@@"))
